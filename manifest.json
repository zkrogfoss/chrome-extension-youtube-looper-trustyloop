{
  "manifest_version": 3,
  "name": "TrustyLoop for YouTube",
  "version": "1.2.0",
  "description": "Loop a YouTube video, or just the part between A and B. From the toolbar or right under the video.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Loop this video",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
